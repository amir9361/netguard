# ──────────────────────────────────────────────
# NetGuard – הגדרות רשת
# ערוך לפי הרשת הביתית שלך לפני הרצה!
# ──────────────────────────────────────────────

# כתובת ה-gateway (הראוטר שלך)
GATEWAY_IP=192.168.1.1

# טווח הרשת לסריקה
SUBNET=192.168.1.0/24

# שם הממשק הרשתי של השרת (הרץ: ip a | grep eth)
IFACE=eth0

# כל כמה שניות לסרוק (ברירת מחדל: 30)
SCAN_INTERVAL=30
